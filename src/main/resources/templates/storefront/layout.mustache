<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    {{#description}}<meta name="description" content="{{description}}">{{/description}}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    {{#description}}<meta property="og:description" content="{{description}}">{{/description}}
    {{#ogImageUrl}}<meta property="og:image" content="{{ogImageUrl}}">{{/ogImageUrl}}
</head>
<body>
    {{#logoUrl}}<img src="{{logoUrl}}" alt="{{shopName}}">{{/logoUrl}}
{{!A page's block tags hug its markup on purpose: whitespace between a block tag
    and the content it holds is whitespace in the rendered page.}}
{{$content}}{{/content}}
</body>
</html>
